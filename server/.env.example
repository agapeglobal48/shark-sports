# Copy to .env for local development. On Railway, set these as service variables.

PORT=5000
NODE_ENV=development

# The storefront's address (used for CORS, Stripe redirects and the sitemap)
CLIENT_URL=http://localhost:5173

# Supabase: transaction pooler (port 6543) for the app, session pooler (port 5432) for migrations
DATABASE_URL=
DIRECT_URL=

# Long random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe: leave empty to keep checkout switched off
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Production only
# TRUST_PROXY=2
